ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

Cors__AllowedOrigins__0=https://your-erp-domain.example

Alibaba__BaseUrl=https://openapi.alibaba.com/rest
Alibaba__ProductPublishPath=
Alibaba__AuthBaseUrl=https://openapi.alibaba.com/rest
Alibaba__AuthTokenCreatePath=/auth/token/create
Alibaba__AuthTokenRefreshPath=/auth/token/refresh
Alibaba__OAuthSuccessRedirect=https://your-erp-domain.example/?alibabaAuth=success
Alibaba__ApiVersion=2.0
Alibaba__DefaultRestMethod=alibaba.open.api.call
Alibaba__ProductPayloadParameter=product_payload
Alibaba__AppKey=
Alibaba__AppSecret=

# Fill these from Alibaba App Console after each API is approved.
Alibaba__Apis__category.tree__Method=/icbu/product/category/get
Alibaba__Apis__category.attributes__Method=/alibaba/icbu/category/attribute/get/v2
Alibaba__Apis__category.get__Method=/alibaba/icbu/category/get/v2
Alibaba__Apis__category.idMapping__Method=/alibaba/icbu/category/id/mapping
Alibaba__Apis__category.predict__Method=/alibaba/icbu/category/predict/v2
Alibaba__Apis__image.upload__Method=/alibaba/icbu/photobank/upload
Alibaba__Apis__photobank.group.list__Method=/icbu/product/photobank/group/list
Alibaba__Apis__photobank.group.operate__Method=/icbu/product/photobank/group/operate
Alibaba__Apis__photobank.list__Method=/icbu/product/photobank/list
Alibaba__Apis__video.query__Method=/alibaba/icbu/video/query
Alibaba__Apis__video.upload__Method=/alibaba/icbu/video/upload
Alibaba__Apis__video.upload.result__Method=/alibaba/icbu/video/upload/result
Alibaba__Apis__video.relation.product.main__Method=/alibaba/icbu/video/relation/product/main
Alibaba__Apis__product.create__Method=/alibaba/icbu/product/listing/v2
Alibaba__Apis__product.update__Method=/alibaba/icbu/product/update/v2
Alibaba__Apis__product.get__Method=/alibaba/icbu/product/get/v2
Alibaba__Apis__product.search__Method=/alibaba/icbu/product/search/v2
Alibaba__Apis__product.status__Method=/alibaba/icbu/product/status/get/v2
Alibaba__Apis__product.status.update__Method=/alibaba/icbu/product/batch/update/status
Alibaba__Apis__product.inventory.update__Method=/icbu/product/edit-inventory
Alibaba__Apis__product.price.update__Method=/icbu/product/edit-price
Alibaba__Apis__product.draft.delete__Method=/alibaba/icbu/draft/delete
Alibaba__Apis__product.offline__Method=/alibaba/icbu/product/batch/update/status
Alibaba__Apis__product.delete__Method=/alibaba/icbu/product/delete
Alibaba__Apis__product.shippingTemplates__Method=/alibaba/icbu/product/list/shipping/templates
Alibaba__Apis__order.search__Method=
Alibaba__Apis__order.detail__Method=
Alibaba__Apis__logistics.freightTemplates__Method=
Alibaba__Apis__logistics.shipment.create__Method=
