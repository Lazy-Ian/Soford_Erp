ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5153

AllowedHosts=erp.soford.cn
Cors__AllowedOrigins__0=https://erp.soford.cn

# Required outside Development: the API refuses to start without them.
Auth__AdminUsername=admin
Auth__AdminPassword=change-this-password
Soford__DataPath=/opt/soford-erp/app_data

# Alibaba.com (ICBU) Open Platform, IOP protocol. Copy AppKey/AppSecret from App Console.
Alibaba__BaseUrl=https://openapi-api.alibaba.com/rest
Alibaba__AppKey=
Alibaba__AppSecret=
Alibaba__OAuthAuthorizeUrl=https://openapi-auth.alibaba.com/oauth/authorize
# Must match the callback URL registered in App Console exactly.
Alibaba__OAuthCallbackUrl=https://erp.soford.cn/openapi/callback
Alibaba__OAuthSuccessRedirect=https://erp.soford.cn/
Alibaba__OAuthSp=icbu

# API paths default to the official ones; override only if App Console shows a different path.
# Alibaba__Apis__order.search__Path=
