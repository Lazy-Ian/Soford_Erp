ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5153

# Primary domain erp.soford.cn; stepnex.cn serves the fallback entry https://stepnex.cn/erp/
# (deploy/nginx/snippets/stepnex-erp.locations.conf) while erp.soford.cn awaits ICP filing.
# www.soford.cn / soford.cn: the public website proxies /public/inquiries to this API (deploy/nginx/soford-website.https.conf).
AllowedHosts=erp.soford.cn;stepnex.cn;www.soford.cn;soford.cn
Cors__AllowedOrigins__0=https://erp.soford.cn
Cors__AllowedOrigins__1=https://stepnex.cn
# Origins of the public website whose quote form may post to /public/inquiries.
Website__AllowedOrigins__0=https://www.soford.cn
Website__AllowedOrigins__1=https://soford.cn
Website__InquiriesPerHourPerIp=10

# Required outside Development: the API refuses to start without them.
Auth__AdminUsername=admin
Auth__AdminPassword=change-this-password
Soford__DataPath=/opt/soford-erp/app_data

# Alibaba.com (ICBU) Open Platform, IOP protocol. Copy AppKey/AppSecret from App Console.
Alibaba__BaseUrl=https://openapi-api.alibaba.com/rest
Alibaba__AppKey=
Alibaba__AppSecret=
Alibaba__OAuthAuthorizeUrl=https://openapi-auth.alibaba.com/oauth/authorize
# Must match the callback URL registered in App Console exactly.
# Currently the fallback entry; switch both to https://erp.soford.cn/openapi/callback and
# https://erp.soford.cn/ once that domain is filed and has a certificate.
Alibaba__OAuthCallbackUrl=https://stepnex.cn/erp/openapi/callback
Alibaba__OAuthSuccessRedirect=https://stepnex.cn/erp/
Alibaba__OAuthSp=icbu

# Optional: AI suggestions for listing titles and keywords (Anthropic Claude). Leave empty to hide the feature.
Anthropic__ApiKey=

# API paths default to the official ones; override only if App Console shows a different path.
# Alibaba__Apis__order.search__Path=
